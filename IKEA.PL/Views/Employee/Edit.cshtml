@using IKEA.PL.ViewModels.EmployeeVms
@model EmployeeViewModel
@{
    ViewData["Title"] = "Edit";
}

<div class="card border border-primary">
    <div class="card-header bg-primary">
        <h1 class="text-white">Edit Employee @Model.Name</h1>
    </div>
    <div class="card-body">

        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input hidden asp-for="ImageName"/> 
                <partial name="PartialViews/CreateEditPartialView" model="@Model" />
            <div class="mt-4 text-center">

                <input type="submit" value="Update" class="btn btn-success"/>
                <a asp-action="Index" class="btn btn-outline-dark">Back to List</a>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>