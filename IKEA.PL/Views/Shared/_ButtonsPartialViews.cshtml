@model int 
<td><a asp-action="Details" asp-route-id="@Model" class="btn btn-primary"><i class="fas fa-eye"></i> Details</a> </td>
<td><a asp-action="Edit" asp-route-id="@Model" class="btn btn-warning"><i class="fas fa-edit"></i> Update</a> </td>
